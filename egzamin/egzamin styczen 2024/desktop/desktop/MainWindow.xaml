<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Wprowadzenie danych do paszportu. Wykonał: 000000000" Height="450" Width="800">
    <Grid>
        <Label Content="Numer" HorizontalAlignment="Left" Margin="97,60,0,0" VerticalAlignment="Top"/>
        <Label Content="Imie" HorizontalAlignment="Left" Margin="97,94,0,0" VerticalAlignment="Top"/>
        <Label Content="Nazwisko" HorizontalAlignment="Left" Margin="97,134,0,0" VerticalAlignment="Top"/>
        <TextBox  Background="Azure" x:Name ="Nazwisko" HorizontalAlignment="Left" Margin="205,139,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox Background="Azure" x:Name ="Imie" HorizontalAlignment="Left" Margin="205,101,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <TextBox TextChanged="Numer_TextChanged"  Background="Azure" x:Name ="Numer" HorizontalAlignment="Left" Margin="205,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <GroupBox Header="Kolor oczu" Height="100" Width="200" Margin="97,261,503,73">
            <Canvas Margin="0,0,-52,-41" Height="auto" Width="auto">

                <RadioButton x:Name="Niebieski" VerticalAlignment="Top" Content="niebieskie" Canvas.Left="17" Canvas.Top="32" HorizontalAlignment="Center"/>
                <RadioButton x:Name="Zielony" VerticalAlignment="Top" Content="zielone" Canvas.Left="19" Canvas.Top="8" HorizontalAlignment="Center"/>
                <RadioButton x:Name="Brazowy" VerticalAlignment="Center" Content="brazowe" Canvas.Left="15" Canvas.Top="58" HorizontalAlignment="Left"/>


            </Canvas>

        </GroupBox>
        <Button  Content="Ok" Width="100" HorizontalAlignment="Left" Margin="521,351,0,0" VerticalAlignment="Top" Background="Azure" Click="Button_Click" />
        <Image x:Name="Obrazek1" HorizontalAlignment="Left" Margin="400,76,0,0" VerticalAlignment="Top" Width="auto" Height="180" Source="/image.jpg"/>
        <Image  x:Name="Obrazek2" HorizontalAlignment="Left" Margin="598,77,0,0" VerticalAlignment="Top" Width="auto" Height="180" Source="/images.jpg"/>

    </Grid>
</Window>
